#!/usr/bin/env bash
# Run the local CI before every push. Skip with `git push --no-verify`.
set -euo pipefail

# Deleting a remote branch pushes nothing worth checking.
pushes_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] || pushes_commits=1
done
[[ "$pushes_commits" == 1 ]] || exit 0

exec "$(git rev-parse --show-toplevel)/scripts/ci.sh"
